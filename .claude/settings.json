{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "alwaysThinkingEnabled": false,
  "tui": "fullscreen",
  "editorMode": "vim",
  "vimInsertModeRemaps": { "jj": "<Esc>" },
  "preferredNotifChannel": "terminal_bell"
}
